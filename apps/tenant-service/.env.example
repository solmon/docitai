# Tenant Service Environment Configuration

# Application
APP_NAME=Tenant Management Service
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=info
__OPEN_API__=true

# Database - PostgreSQL (default)
# For PostgreSQL:
# DB_DATABASE_URL=postgresql://user:password@localhost:5432/tenant_db
# DB_DATABASE_TYPE=postgresql

# For MSSQL Server (using pymssql - native driver):
DB_DATABASE_URL=mssql+pymssql://sa:DocitaiDev@123@localhost:1433/docitai_dev
DB_DATABASE_TYPE=sqlserver
DB_ECHO_SQL=False

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# JWT
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Storage (Cloud Provider Credentials - Example S3)
# STORAGE_PROVIDER=s3
# AWS_ACCESS_KEY_ID=your-aws-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=your-bucket-name

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
